{
	"FileVersion": 3,
	"Version": 2,
	"VersionName": "2.0.0",
	"FriendlyName": "AgentFramework AI Assistant",
	"Description": "Unreal Engine 5.9 Agentic AI extension plugin providing 6 native ToolsetRegistry toolsets for C++ scaffolding and reflection, project packaging and lighting builds, Enhanced Input authoring, Animation/IKRig/Motion Matching authoring, GAS AttributeSet/GameplayEffect authoring, and PIE actor UFunction invocation alongside UE 5.9's built-in ModelContextProtocol server.",
	"Category": "AI",
	"CreatedBy": "AgentFramework Contributors",
	"CreatedByURL": "https://github.com/your-org/UE-AgentFramework",
	"DocsURL": "https://github.com/your-org/UE-AgentFramework/wiki",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/your-org/UE-AgentFramework/issues",
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EngineVersion": "5.9.0",
	"Modules": [
		{
			"Name": "AgentFrameworkCore",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Linux",
				"Mac"
			]
		},
		{
			"Name": "AgentFrameworkActions",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64",
				"Linux",
				"Mac"
			]
		}
	],
	"Plugins": [
		{
			"Name": "ModelContextProtocol",
			"Enabled": true
		},
		{
			"Name": "ToolsetRegistry",
			"Enabled": true
		},
		{
			"Name": "AllToolsets",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "GeometryToolset",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "KnowledgeBaseToolset",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "SequencerAnimMixerToolset",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "AIAssistant",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "AgentCapability",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "AgentLook",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "EditorScriptingUtilities",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "EnhancedInput",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "PythonScriptPlugin",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "GameplayAbilities",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "StateTree",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "SmartObjects",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "MassGameplay",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "MassCrowd",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "UnrealCanvasAnnotations",
			"Enabled": true,
			"Optional": true
		},
		{
			"Name": "UnrealCanvasBridge",
			"Enabled": true,
			"Optional": true
		}
	]
}
